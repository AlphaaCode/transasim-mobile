// The esimple flavor on iOS: what Android's productFlavor "esimple" and
// android/app/src/esimple/res are on that side. The OS reads these before any
// Dart runs, so they repeat brands/esimple/brand.json, and
// test/core/brand_wiring_test.dart keeps the two equal. Base configuration of
// Debug-esimple, Release-esimple and Profile-esimple (Runner target), which the
// "esimple" scheme selects.
#include "Generated.xcconfig"

PRODUCT_BUNDLE_IDENTIFIER = com.esimple.esim
APP_DISPLAY_NAME = eSimple
DEVELOPMENT_TEAM = DP7F8WQCJD

// Only this brand's catalog (app icon, launch colour) is compiled in; the
// target excludes every Brand-*.xcassets and this brings its own one back.
INCLUDED_SOURCE_FILE_NAMES = Brand-esimple.xcassets

// Google sign-in. GIDClientID is the iOS OAuth client in the brand's Google
// project, its reversed form is the URL scheme Google calls back on, and
// GIDServerClientID is mobile.googleServerClientId: the web client the
// backend checks the ID token's audience against. On iOS the plugin ignores
// the serverClientId Dart passes unless a client ID comes with it, so
// Info.plist is where both have to be.
GOOGLE_IOS_CLIENT_ID = 1029607422562-bh3kj59gp468knt6k1fme0pgjo66ua1e.apps.googleusercontent.com
GOOGLE_REVERSED_CLIENT_ID = com.googleusercontent.apps.1029607422562-bh3kj59gp468knt6k1fme0pgjo66ua1e
GOOGLE_SERVER_CLIENT_ID = 1029607422562-dnv5kd97665ls15och6nss7kdi62q1md.apps.googleusercontent.com
