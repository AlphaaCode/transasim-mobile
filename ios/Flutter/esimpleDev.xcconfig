// The esimpleDev flavor on iOS (Slice H): the DEV build, on the DEV server,
// what Android's productFlavor "esimpleDev" is on that side. Its bundle id
// and name are the store app's + ".dev" and + " DEV", so the two install side
// by side and a DEV build is never taken for the store one. Base
// configuration of Debug-esimpleDev, Release-esimpleDev and
// Profile-esimpleDev (Runner target), which the "esimpleDev" scheme selects.
//
// Generated by Studio (tool/studio) from brands/esimple/brand.json and
// studio.json: edit those, never this file.
#include "Generated.xcconfig"

PRODUCT_BUNDLE_IDENTIFIER = com.esimple.esim.dev
APP_DISPLAY_NAME = eSimple DEV
DEVELOPMENT_TEAM = DP7F8WQCJD

// The store app's catalog: its icon and launch colour.
INCLUDED_SOURCE_FILE_NAMES = Brand-esimple.xcassets

// Google sign-in needs an iOS OAuth client made for the .dev bundle id
// (mobile.devGoogleIosClientId, guide google-ios-client-dev). Until it exists
// these two are empty and Google sign-in fails in DEV builds; e-mail sign-in
// still works. The web client is the store app's.
GOOGLE_IOS_CLIENT_ID = 
GOOGLE_REVERSED_CLIENT_ID = 
GOOGLE_SERVER_CLIENT_ID = 1029607422562-dnv5kd97665ls15och6nss7kdi62q1md.apps.googleusercontent.com
