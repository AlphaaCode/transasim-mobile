// The acorn flavor on iOS: what Android's productFlavor "acorn" and
// android/app/src/acorn/res are on that side. The OS reads these before any
// Dart runs, so they repeat brands/acorn/brand.json, and
// test/core/brand_wiring_test.dart keeps the two equal. Base configuration of
// Debug-acorn, Release-acorn and Profile-acorn (Runner target), which the
// "acorn" scheme selects.
//
// Generated by Studio (tool/studio) from brands/acorn/brand.json and
// studio.json: edit those, never this file.
#include "Generated.xcconfig"

PRODUCT_BUNDLE_IDENTIFIER = com.odysseysim.esim
APP_DISPLAY_NAME = Odyssey Global SIM
DEVELOPMENT_TEAM = DP7F8WQCJD

// Only this brand's catalog (app icon, launch colour) is compiled in; the
// target excludes every Brand-*.xcassets and this brings its own one back.
INCLUDED_SOURCE_FILE_NAMES = Brand-acorn.xcassets

// Google sign-in. GIDClientID is the iOS OAuth client in the brand's Google
// project (mobile.googleIosClientId), its reversed form is the URL scheme
// Google calls back on, and GIDServerClientID is mobile.googleServerClientId:
// the web client the backend checks the ID token's audience against. On iOS
// the plugin ignores the serverClientId Dart passes unless a client ID comes
// with it, so Info.plist is where both have to be.
GOOGLE_IOS_CLIENT_ID = 488318141005-n9c1abv1t3tb0pfdpven8nfbcaq3evvp.apps.googleusercontent.com
GOOGLE_REVERSED_CLIENT_ID = com.googleusercontent.apps.488318141005-n9c1abv1t3tb0pfdpven8nfbcaq3evvp
GOOGLE_SERVER_CLIENT_ID = 488318141005-d03oqsp9vm02lhlqntsjefj7cljmg6lu.apps.googleusercontent.com
