// The acornDev flavor on iOS (Slice H): the DEV build, on the DEV server,
// what Android's productFlavor "acornDev" is on that side. Its bundle id
// and name are the store app's + ".dev" and + " DEV", so the two install side
// by side and a DEV build is never taken for the store one. Base
// configuration of Debug-acornDev, Release-acornDev and
// Profile-acornDev (Runner target), which the "acornDev" scheme selects.
//
// Generated by Studio (tool/studio) from brands/acorn/brand.json and
// studio.json: edit those, never this file.
#include "Generated.xcconfig"

PRODUCT_BUNDLE_IDENTIFIER = com.odysseysim.esim.dev
APP_DISPLAY_NAME = Odyssey Global SIM DEV
DEVELOPMENT_TEAM = DP7F8WQCJD

// The store app's catalog: its icon and launch colour.
INCLUDED_SOURCE_FILE_NAMES = Brand-acorn.xcassets

// Google sign-in needs an iOS OAuth client made for the .dev bundle id
// (mobile.devGoogleIosClientId, guide google-ios-client-dev). Until it exists
// these two are empty and Google sign-in fails in DEV builds; e-mail sign-in
// still works. The web client is the store app's.
GOOGLE_IOS_CLIENT_ID = 
GOOGLE_REVERSED_CLIENT_ID = 
GOOGLE_SERVER_CLIENT_ID = 488318141005-d03oqsp9vm02lhlqntsjefj7cljmg6lu.apps.googleusercontent.com
