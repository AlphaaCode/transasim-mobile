// The sabilyDev flavor on iOS (Slice H): the DEV build, on the DEV server,
// what Android's productFlavor "sabilyDev" is on that side. Its bundle id
// and name are the store app's + ".dev" and + " DEV", so the two install side
// by side and a DEV build is never taken for the store one. Base
// configuration of Debug-sabilyDev, Release-sabilyDev and
// Profile-sabilyDev (Runner target), which the "sabilyDev" scheme selects.
//
// Generated by Studio (tool/studio) from brands/sabily/brand.json and
// studio.json: edit those, never this file.
#include "Generated.xcconfig"

PRODUCT_BUNDLE_IDENTIFIER = com.sabily.esim.dev
APP_DISPLAY_NAME = Sabily DEV
DEVELOPMENT_TEAM = DP7F8WQCJD

// The store app's catalog: its icon and launch colour.
INCLUDED_SOURCE_FILE_NAMES = Brand-sabily.xcassets

// Google sign-in needs an iOS OAuth client made for the .dev bundle id
// (mobile.devGoogleIosClientId, guide google-ios-client-dev). Until it exists
// these two are empty and Google sign-in fails in DEV builds; e-mail sign-in
// still works. The web client is the store app's.
GOOGLE_IOS_CLIENT_ID = 
GOOGLE_REVERSED_CLIENT_ID = 
GOOGLE_SERVER_CLIENT_ID = 83118739145-b5b4v7v8td3f737neol99dj427jclmqt.apps.googleusercontent.com
