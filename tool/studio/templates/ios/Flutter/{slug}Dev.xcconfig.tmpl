// The {{slug}}Dev flavor on iOS (Slice H): the DEV build, on the DEV server,
// what Android's productFlavor "{{slug}}Dev" is on that side. Its bundle id
// and name are the store app's + ".dev" and + " DEV", so the two install side
// by side and a DEV build is never taken for the store one. Base
// configuration of Debug-{{slug}}Dev, Release-{{slug}}Dev and
// Profile-{{slug}}Dev (Runner target), which the "{{slug}}Dev" scheme selects.
//
// Generated by Studio (tool/studio) from brands/{{slug}}/brand.json and
// studio.json: edit those, never this file.
#include "Generated.xcconfig"

PRODUCT_BUNDLE_IDENTIFIER = {{devBundleIdentifier}}
APP_DISPLAY_NAME = {{devDisplayName}}
DEVELOPMENT_TEAM = {{appleTeamId}}

// The store app's catalog: its icon and launch colour.
INCLUDED_SOURCE_FILE_NAMES = Brand-{{slug}}.xcassets

// Google sign-in needs an iOS OAuth client made for the .dev bundle id
// (mobile.devGoogleIosClientId, guide google-ios-client-dev). Until it exists
// these two are empty and Google sign-in fails in DEV builds; e-mail sign-in
// still works. The web client is the store app's.
GOOGLE_IOS_CLIENT_ID = {{devGoogleIosClientId}}
GOOGLE_REVERSED_CLIENT_ID = {{devGoogleReversedClientId}}
GOOGLE_SERVER_CLIENT_ID = {{googleServerClientId}}
